# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The whole site reads from Postgres, so this must be set or every page shows
# "Database not ready".
#
# Local dev: paste the connection string from your Neon dashboard
#   (Neon -> your project -> Connection Details -> copy the "psql"/URI string).
# Vercel: connecting a Postgres/Neon database under Storage adds POSTGRES_*
#   automatically, so you do not set this by hand there.
POSTGRES_URL=

# ---------------------------------------------------------------------------
# Admin login
# ---------------------------------------------------------------------------
# Set these yourself, both locally and in Vercel
# (Project -> Settings -> Environment Variables).
# Login is refused outright when either is blank.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Any long random string - used to sign admin session cookies.
# Generate one with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=
